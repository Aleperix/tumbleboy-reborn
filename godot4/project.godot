; Engine configuration file.
; TumbleBoy Reborn — port a Godot 4.7 (renderer Compatibility = OpenGL ES 3.0).
; Raíz godot3 intacta (GLES2, targetSdk 35) para hardware ES 2.0-only.

config_version=5

[application]

config/name="TumbleBoy Reborn"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/tumbleboy/icon.png"
config/quit_on_go_back=false

[autoload]

AudioManager="*res://autoload/audio_manager.gd"
SaveData="*res://autoload/save_data.gd"
InputManager="*res://autoload/input_manager.gd"
LevelQueue="*res://autoload/level_queue.gd"
NavParams="*res://autoload/nav_params.gd"

[display]

window/size/viewport_width=1200
window/size/viewport_height=825
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
