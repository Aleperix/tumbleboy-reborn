; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="Lost Games XO"
run/main_scene="res://scenes/MainMenu.tscn"
config/icon="res://icon.svg"

[autoload]

AudioManager="*res://autoload/audio_manager.gd"
SaveData="*res://autoload/save_data.gd"
InputManager="*res://autoload/input_manager.gd"

[display]

window/size/width=1200
window/size/height=825
window/stretch/mode="2d"
window/stretch/aspect="keep"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

quality/driver/driver_name="GLES2"
quality/render_loop/gles2/dynamic_buffer_size=true
